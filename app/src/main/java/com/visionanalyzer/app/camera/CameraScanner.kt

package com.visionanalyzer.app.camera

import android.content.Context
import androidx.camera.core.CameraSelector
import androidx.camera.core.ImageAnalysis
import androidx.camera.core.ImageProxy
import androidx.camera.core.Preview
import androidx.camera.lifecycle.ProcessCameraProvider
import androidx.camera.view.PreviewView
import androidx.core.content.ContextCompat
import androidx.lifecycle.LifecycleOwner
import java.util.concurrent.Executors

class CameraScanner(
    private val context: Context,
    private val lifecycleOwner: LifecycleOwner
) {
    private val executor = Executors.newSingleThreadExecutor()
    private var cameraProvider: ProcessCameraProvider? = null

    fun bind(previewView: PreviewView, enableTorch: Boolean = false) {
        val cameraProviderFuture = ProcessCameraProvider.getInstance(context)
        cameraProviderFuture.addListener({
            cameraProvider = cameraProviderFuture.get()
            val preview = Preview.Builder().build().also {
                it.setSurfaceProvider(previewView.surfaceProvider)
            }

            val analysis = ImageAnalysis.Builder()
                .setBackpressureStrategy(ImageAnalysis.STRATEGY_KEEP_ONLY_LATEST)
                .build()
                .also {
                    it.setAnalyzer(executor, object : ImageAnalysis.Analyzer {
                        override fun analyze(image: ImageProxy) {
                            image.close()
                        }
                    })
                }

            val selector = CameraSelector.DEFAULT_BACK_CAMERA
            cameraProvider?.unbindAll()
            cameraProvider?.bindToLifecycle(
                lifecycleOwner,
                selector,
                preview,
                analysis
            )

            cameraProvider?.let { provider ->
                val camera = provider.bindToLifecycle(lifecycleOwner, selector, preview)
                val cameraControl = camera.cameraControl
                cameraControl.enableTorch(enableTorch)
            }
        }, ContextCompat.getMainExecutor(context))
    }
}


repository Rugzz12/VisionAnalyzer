    fun computeRiskLevel(summary: AnalysisSummary): AnalysisState = when (summary.state) {
        AnalysisState.NORMAL -> AnalysisState.NORMAL
        AnalysisState.CHANGE -> AnalysisState.LOW
        AnalysisState.UNKNOWN -> AnalysisState.MEDIUM
        AnalysisState.LOW -> AnalysisState.LOW
        AnalysisState.MEDIUM -> AnalysisState.MEDIUM
        AnalysisState.HIGH -> AnalysisState.HIGH
    }

    fun clampConfidence(value: Int): Int = value.coerceIn(0, 100)
    fun sanitizeText(raw: String): String = raw.trim().ifBlank { "No recognition produced" }
